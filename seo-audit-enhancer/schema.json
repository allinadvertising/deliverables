{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allinadvertising.com/schemas/audit-content-v2.json",
  "title": "Audit Content v2",
  "description": "Versioned storytelling audit content stored for new audit submissions. Legacy records retain their original schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "meta", "issues", "glossary", "faq"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientName",
        "auditType",
        "date",
        "supportingFile",
        "sourceNote"
      ],
      "properties": {
        "clientName": { "type": "string", "minLength": 1 },
        "auditType": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1 },
        "supportingFile": { "type": ["string", "null"] },
        "sourceNote": { "type": ["string", "null"] },
        "sourceFiles": {
          "type": ["array", "null"],
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "what_is_the_issue",
          "why_it_matters",
          "how_we_will_fix_it",
          "expected_outcome"
        ],
        "properties": {
          "what_is_the_issue": { "type": "string", "minLength": 1 },
          "why_it_matters": { "type": "string", "minLength": 1 },
          "how_we_will_fix_it": { "type": "string", "minLength": 1 },
          "expected_outcome": { "type": "string", "minLength": 1 }
        }
      }
    },
    "insightBox": { "type": ["string", "null"], "minLength": 1 },
    "glossary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["term", "definition"],
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "definition": { "type": "string", "minLength": 1 }
        }
      }
    },
    "faq": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "answer"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "answer": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
