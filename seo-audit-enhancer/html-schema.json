{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allinadvertising.com/schemas/audit-content-v3.json",
  "title": "Audit Content v3 (HTML deliverable, block-based)",
  "description": "Flattened block content for self-contained HTML deliverable uploads. Legacy and v2 records retain their own schemas.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "meta", "blocks"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientName",
        "auditType",
        "date",
        "supportingFile",
        "sourceNote",
        "sourceType",
        "sourceHtmlPath"
      ],
      "properties": {
        "clientName": { "type": "string", "minLength": 1 },
        "auditType": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1 },
        "supportingFile": { "type": ["string", "null"] },
        "sourceNote": { "type": ["string", "null"] },
        "sourceType": { "const": "html" },
        "sourceHtmlPath": { "type": ["string", "null"] }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "level", "text"],
          "properties": {
            "type": { "const": "heading" },
            "level": { "enum": [2, 3] },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text"],
          "properties": {
            "type": { "const": "paragraph" },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "cards"],
          "properties": {
            "type": { "const": "stat_cards" },
            "cards": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "label", "change", "sentiment"],
                "properties": {
                  "value": { "type": "string", "minLength": 1 },
                  "label": { "type": "string", "minLength": 1 },
                  "change": { "type": ["string", "null"] },
                  "sentiment": { "enum": ["positive", "negative", "neutral", null] }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "ordered", "items"],
          "properties": {
            "type": { "const": "list" },
            "ordered": { "type": "boolean" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "caption", "headers", "rows"],
          "properties": {
            "type": { "const": "table" },
            "caption": { "type": ["string", "null"] },
            "headers": { "type": "array", "items": { "type": "string" } },
            "rows": {
              "type": "array",
              "items": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "tone", "text", "label"],
          "properties": {
            "type": { "const": "callout" },
            "tone": { "enum": ["info", "warning", "success"] },
            "text": { "type": "string", "minLength": 1 },
            "label": { "type": ["string", "null"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "src", "alt", "caption"],
          "properties": {
            "type": { "const": "image" },
            "src": { "type": "string", "minLength": 1 },
            "alt": { "type": "string" },
            "caption": { "type": ["string", "null"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "text", "attribution"],
          "properties": {
            "type": { "const": "quote" },
            "text": { "type": "string", "minLength": 1 },
            "attribution": { "type": ["string", "null"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "terms"],
          "properties": {
            "type": { "const": "glossary" },
            "terms": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["term", "definition"],
                "properties": {
                  "term": { "type": "string", "minLength": 1 },
                  "definition": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "items"],
          "properties": {
            "type": { "const": "faq" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["question", "answer"],
                "properties": {
                  "question": { "type": "string", "minLength": 1 },
                  "answer": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
